# ============================================================
# Elite Pitch Frontend - Environment Variables
# Copy this to front-end/.env for local dev
# Also set these in Vercel Dashboard -> Project -> Settings -> Environment Variables
# Get all values from: Firebase Console -> Project Settings -> Your apps -> Web app
# ============================================================

# Firebase Web App Config
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=elite-turf-64ba8.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=elite-turf-64ba8
VITE_FIREBASE_STORAGE_BUCKET=elite-turf-64ba8.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=1:your_app_id

# Optional: Backend API URL
# Leave blank to use same-origin /api on Vercel (recommended)
VITE_API_URL=
